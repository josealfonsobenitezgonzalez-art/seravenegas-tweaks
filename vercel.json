{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/web/bronce/fauna-iberica/:path*", "destination": "/#obra", "permanent": true },
    { "source": "/web/bronce/fauna-africana/:path*", "destination": "/#obra", "permanent": true },
    { "source": "/web/bronce/trofeos/:path*", "destination": "/#obra", "permanent": true },
    { "source": "/web/bronce/:path*", "destination": "/#obra", "permanent": true },
    { "source": "/pinturas", "destination": "/", "permanent": true },
    { "source": "/web/pinturas/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
