---
import IconWa from './IconWa.astro';
import { waGeneral } from '../lib/obras';
---
<a class="wa-fab" href={waGeneral} aria-label="Escribir a Serafín por WhatsApp">
  <IconWa size={28} />
</a>

<style>
  .wa-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 60;
    width: 64px;
    height: 64px;
    border-radius: var(--r-pill);
    background: var(--sage);
    color: var(--ivory);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(42, 38, 32, 0.28);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .wa-fab:hover {
    background: #7b7d6a;
    color: var(--ivory);
    transform: translateY(-2px);
  }
  @media (max-width: 900px) {
    .wa-fab {
      bottom: 16px;
      right: 16px;
      width: 58px;
      height: 58px;
    }
  }
</style>
