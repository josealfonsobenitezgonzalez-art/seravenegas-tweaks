---
import { getImage } from 'astro:assets';
import IconWa from './IconWa.astro';
import { portada, waPortadaObra, waDisponibilidad } from '../lib/obras';

// Portada: escritorio usa la foto original (cover); móvil usa el recorte (contain).
const dWidths = [700, 1000, 1400];
const mWidths = [360, 520, 760];

const dAvif = await getImage({ src: portada.imagen, widths: dWidths, format: 'avif' });
const dWebp = await getImage({ src: portada.imagen, widths: dWidths, format: 'webp' });
const dJpg = await getImage({ src: portada.imagen, widths: dWidths, format: 'jpg' });

const mAvif = await getImage({ src: portada.recorte, widths: mWidths, format: 'avif' });
const mWebp = await getImage({ src: portada.recorte, widths: mWidths, format: 'webp' });
const mJpg = await getImage({ src: portada.recorte, widths: mWidths, format: 'jpg' });

const altPortada = 'Macho montés en bronce sobre una roca, con peana de madera';
---
<section id="inicio" class="hero container">
  <div class="hero__text">
    <p class="eyebrow" style="color: var(--earth)">Escultura en bronce · Serafín Venegas</p>
    <h1 class="h1">La fauna,<em>fundida en bronce.</em></h1>
    <p class="lead hero__lead">
      Bienvenidos a esta página, donde quiero mostraros mi trabajo de escultura en bronce.
      En ella encontraréis una selección de esculturas cinegéticas —tanto de fauna africana
      como ibérica— y un apartado de trofeos, con las piezas realizadas por encargo para
      premios y homenajes.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={waDisponibilidad}>
        <IconWa size={20} />
        Consultar disponibilidad
      </a>
      <a class="btn btn--outline" href="#obra">Ver la obra</a>
    </div>
  </div>

  <figure class="hero__figure">
    <div class="hero__frame">
      <picture>
        <source media="(min-width: 901px)" type="image/avif" srcset={dAvif.srcSet.attribute} sizes="(min-width: 1440px) 700px, 48vw" />
        <source media="(min-width: 901px)" type="image/webp" srcset={dWebp.srcSet.attribute} sizes="(min-width: 1440px) 700px, 48vw" />
        <source media="(max-width: 900px)" type="image/avif" srcset={mAvif.srcSet.attribute} sizes="(max-width: 430px) 100vw, 390px" />
        <source media="(max-width: 900px)" type="image/webp" srcset={mWebp.srcSet.attribute} sizes="(max-width: 430px) 100vw, 390px" />
        <img
          src={dJpg.src}
          srcset={mJpg.srcSet.attribute}
          sizes="(max-width: 430px) 100vw, 390px"
          width={dJpg.attributes.width}
          height={dJpg.attributes.height}
          alt={altPortada}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <figcaption class="hero__caption">
      <span>
        <span class="hero__caption-title">Macho montés sobre roca</span> · Bronce
      </span>
      <a class="link-strong" href={waPortadaObra} style="color: var(--sage)">
        <IconWa size={26} variant="phone" />
        Preguntar por esta obra
      </a>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 6vw, 96px);
    align-items: stretch;
  }
  .hero__text {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 28px;
    justify-content: flex-start;
  }
  .hero__lead {
    max-width: 480px;
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16px;
  }
  .hero__figure {
    grid-column: 7 / span 6;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hero__frame {
    flex: 1 1 auto;
    min-height: 0;
    background: var(--white);
    border-radius: var(--r-img);
    overflow: hidden;
  }
  .hero__frame picture,
  .hero__frame img {
    width: 100%;
    height: 100%;
  }
  .hero__frame img {
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero__caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--meta);
    color: var(--muted);
  }
  .hero__caption-title {
    font-family: var(--font-title);
    font-size: 1.1875rem;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    /* En móvil: eyebrow → H1 → texto → foto → botones debajo de la foto.
       display:contents saca los hijos del texto al flujo del hero para reordenarlos. */
    .hero__text {
      display: contents;
    }
    .hero__text > .eyebrow,
    .hero__text > .h1,
    .hero__text > .hero__lead {
      order: 1;
    }
    .hero__figure {
      order: 2;
    }
    .hero__actions {
      order: 3;
      margin-top: 4px;
    }
    .hero__frame {
      height: 460px;
      flex: none;
    }
    .hero__frame img {
      object-fit: contain;
      object-position: center;
    }
  }
</style>
