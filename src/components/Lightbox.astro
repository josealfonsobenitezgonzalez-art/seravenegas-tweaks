---
import IconWa from './IconWa.astro';
---
<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lb-title"
  tabindex="-1"
  data-open="false"
>
  <div class="lightbox__inner">
    <div class="lightbox__figure">
      <img id="lb-img" alt="" />
    </div>
    <div class="lightbox__panel">
      <div class="lightbox__top">
        <span class="lightbox__counter" id="lb-counter" aria-live="polite"></span>
        <button type="button" class="icon-btn" id="lb-close" aria-label="Cerrar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <div class="lightbox__col" id="lb-col"></div>
      <h3 class="lightbox__title" id="lb-title"></h3>
      <div class="lightbox__meta" id="lb-meta"></div>
      <a class="btn btn--sand" id="lb-wa" href="#" style="margin-top: 16px">
        <IconWa size={26} variant="phone" />
        <span id="lb-cta"></span>
      </a>
      <div class="lightbox__nav">
        <button type="button" class="icon-btn" id="lb-prev" aria-label="Obra anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>
        <button type="button" class="icon-btn" id="lb-next" aria-label="Obra siguiente">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
      <span class="lightbox__hint">Desliza para ver la siguiente obra</span>
    </div>
  </div>
</div>

<script>
  interface Work {
    id: string;
    title: string;
    col: string;
    meta: string;
    cta: string;
    wa: string;
    alt: string;
    full: string;
  }
  interface Catalogo {
    id: string;
    label: string;
    works: Work[];
  }

  const raw = document.getElementById('obras-catalogo')?.textContent ?? '[]';
  const catalogo: Catalogo[] = JSON.parse(raw);
  const porId = new Map<string, Catalogo>(catalogo.map((c) => [c.id, c]));

  // ---------- Pestañas (galería) -----------------------------------------
  const tabBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]'),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>('[data-panel]'),
  );

  function activarTab(id: string, foco = false) {
    tabBtns.forEach((b) => {
      const on = b.dataset.tabBtn === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && foco) b.focus();
    });
    panels.forEach((p) => {
      p.hidden = p.dataset.panel !== id;
    });
  }

  tabBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => activarTab(btn.dataset.tabBtn!));
    btn.addEventListener('keydown', (e) => {
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabBtns.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
        next = (i - 1 + tabBtns.length) % tabBtns.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabBtns.length - 1;
      if (next >= 0) {
        e.preventDefault();
        activarTab(tabBtns[next].dataset.tabBtn!, true);
      }
    });
  });

  // Enlaces "Ver colección →" que además cambian de pestaña.
  document.querySelectorAll<HTMLAnchorElement>('a[data-tab]').forEach((a) => {
    a.addEventListener('click', () => activarTab(a.dataset.tab!));
  });

  // ---------- Vista ampliada (lightbox) ----------------------------------
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter') as HTMLElement;
  const lbCol = document.getElementById('lb-col') as HTMLElement;
  const lbTitle = document.getElementById('lb-title') as HTMLElement;
  const lbMeta = document.getElementById('lb-meta') as HTMLElement;
  const lbWa = document.getElementById('lb-wa') as HTMLAnchorElement;
  const lbCta = document.getElementById('lb-cta') as HTMLElement;
  const btnClose = document.getElementById('lb-close') as HTMLButtonElement;
  const btnPrev = document.getElementById('lb-prev') as HTMLButtonElement;
  const btnNext = document.getElementById('lb-next') as HTMLButtonElement;

  let lista: Work[] = [];
  let idx = 0;
  let opener: HTMLElement | null = null;

  function render() {
    const w = lista[idx];
    if (!w) return;
    lbImg.src = w.full;
    lbImg.alt = w.alt;
    lbCol.textContent = w.col;
    lbTitle.textContent = w.title;
    lbMeta.textContent = w.meta;
    lbCta.textContent = w.cta;
    lbWa.href = w.wa;
    lbCounter.textContent = `${idx + 1} / ${lista.length}`;
  }

  function go(d: number) {
    const n = lista.length;
    idx = ((idx + d) % n + n) % n;
    render();
  }

  function focusables(): HTMLElement[] {
    return Array.from(
      lb.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    ).filter((el) => el.offsetParent !== null);
  }

  function open(collectionId: string, index: number, from: HTMLElement) {
    const col = porId.get(collectionId);
    if (!col) return;
    lista = col.works;
    idx = Math.min(Math.max(index, 0), lista.length - 1);
    opener = from;
    render();
    lb.dataset.open = 'true';
    document.body.classList.add('no-scroll');
    lb.focus();
  }

  function close() {
    lb.dataset.open = 'false';
    document.body.classList.remove('no-scroll');
    if (opener && opener.focus) opener.focus();
    opener = null;
  }

  // Aperturas desde tarjetas de obra y de colección.
  document
    .querySelectorAll<HTMLButtonElement>('[data-open-lightbox]')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        open(btn.dataset.collection!, Number(btn.dataset.index ?? 0), btn);
      });
    });

  btnClose.addEventListener('click', close);
  btnPrev.addEventListener('click', () => go(-1));
  btnNext.addEventListener('click', () => go(1));

  // Clic en el fondo cierra.
  lb.addEventListener('click', (e) => {
    if (e.target === lb || e.target === lb.firstElementChild) close();
  });

  // Teclado: Escape, flechas y trampa de foco con Tab.
  lb.addEventListener('keydown', (e) => {
    if (lb.dataset.open !== 'true') return;
    if (e.key === 'Escape') {
      e.preventDefault();
      close();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      go(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      go(1);
    } else if (e.key === 'Tab') {
      const f = focusables();
      if (f.length === 0) return;
      const first = f[0];
      const last = f[f.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && (active === first || active === lb)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Deslizar en móvil.
  let tx: number | null = null;
  const fig = lb.querySelector('.lightbox__figure') as HTMLElement;
  fig.addEventListener(
    'touchstart',
    (e) => {
      tx = e.touches[0]?.clientX ?? null;
    },
    { passive: true },
  );
  fig.addEventListener('touchend', (e) => {
    if (tx == null) return;
    const dx = (e.changedTouches[0]?.clientX ?? tx) - tx;
    tx = null;
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
  });
</script>
